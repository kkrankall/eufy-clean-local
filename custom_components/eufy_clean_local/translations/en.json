{
  "config": {
    "step": {
      "user": {
        "title": "eufy account",
        "description": "Your eufy app login is used once to look up the robot's local key, and later to download its map. Control and status stay on your local network.",
        "data": {
          "email": "Email",
          "password": "Password"
        }
      },
      "pick": {
        "title": "Choose a robot",
        "data": {
          "device_id": "Robot"
        }
      },
      "reauth_confirm": {
        "title": "Sign in to eufy again",
        "description": "eufy rejected the saved login for {email}. Enter the account's current password.",
        "data": {
          "password": "Password"
        }
      }
    },
    "error": {
      "invalid_auth": "eufy rejected the email or password.",
      "cannot_connect": "Could not reach the eufy or Tuya cloud. Check the log for details.",
      "no_devices": "No supported robot (L60 family or RoboVac 30C) with a local key was found on this account, or they're all set up already."
    },
    "abort": {
      "already_configured": "This robot is already set up.",
      "reauth_successful": "Signed in again; the integration has reloaded."
    }
  },
